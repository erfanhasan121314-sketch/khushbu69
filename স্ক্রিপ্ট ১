const products=[
  {name:"Khushbu Noir",notes:"Oud • Vanilla • Amber",price:1499,old:1899,badge:"BEST SELLER"},
  {name:"Khushbu Rêve",notes:"Floral • Musk • Vanilla",price:1299,old:1799,badge:"NEW"},
  {name:"Khushbu Ocean",notes:"Citrus • Marine • Musk",price:1199,old:1699,badge:""},
  {name:"Khushbu Amber",notes:"Amber • Sandalwood • Musk",price:1399,old:1899,badge:""}
];
const grid=document.getElementById("productGrid");
grid.innerHTML=products.map((p,i)=>`<article class="product">
  <div class="product-img">${p.badge?`<span class="badge">${p.badge}</span>`:""}<div class="bottle" style="filter:hue-rotate(${i*38}deg)"></div></div>
  <h3>${p.name}</h3><div class="notes">${p.notes}</div>
  <div class="price">৳${p.price.toLocaleString()} <span class="old">৳${p.old.toLocaleString()}</span></div>
  <div class="stars">★★★★★ <span style="color:#777">(124)</span></div>
</article>`).join("");
let count=0;
document.querySelectorAll(".product").forEach(card=>card.addEventListener("click",()=>{count++;document.getElementById("cartCount").textContent=count;}));